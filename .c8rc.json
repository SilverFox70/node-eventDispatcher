{
  "all": true,
  "src": [
    "dist/cjs",
    "server/src",
    "examples/legacy"
  ],
  "extension": [
    ".js",
    ".ts",
    ".cjs"
  ],
  "include": [
    "dist/**/*.js",
    "src/**/*.ts",
    "server/src/eventDispatcher.js",
    "examples/legacy/*.cjs"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/test/**",
    "**/node_modules/**"
  ],
  "exclude-after-remap": true,
  "reporter": [
    "json",
    "text",
    "html"
  ]
}
