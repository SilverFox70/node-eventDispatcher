{
  "name": "event-driven-design",
  "version": "1.0.0",
  "description": "Typed flow-based programming and event dispatch for Node.js",
  "main": "./dist/cjs/index.js",
  "scripts": {
    "main": "node examples/01-map-filter.cjs",
    "test": "npm run build && node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p test/types/tsconfig.json",
    "lint": "eslint src scripts test examples templates/node benchmark fixtures/next-consumer/app fixtures/next-consumer/lib",
    "check": "npm run build && npm run typecheck && npm run lint",
    "coverage": "npm run build && c8 node --test test/*.test.js && node scripts/coverage-thresholds.mjs",
    "test:package": "npm run build && node --test test/package.test.js test/package-contracts.test.js test/author-recipe.test.js test/examples.test.js",
    "test:next": "node scripts/test-next.mjs",
    "demo:next": "node scripts/test-next.mjs --serve",
    "stress:http": "npm run test:next"
  },
  "keywords": [
    "EDD",
    "eventdriven",
    "design"
  ],
  "author": "William F Brinkert",
  "license": "ISC",
  "dependencies": {
    "zod": "4.6.7"
  },
  "types": "./dist/cjs/index.d.ts",
  "type": "commonjs",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/esm/model/index.d.ts",
        "default": "./dist/esm/model/index.js"
      },
      "require": {
        "types": "./dist/cjs/model/index.d.ts",
        "default": "./dist/cjs/model/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    },
    "./server/src/eventDispatcher.js": "./server/src/eventDispatcher.js"
  },
  "files": [
    "dist",
    "src",
    "server/src/eventDispatcher.js",
    "examples",
    "templates",
    "docs/guide.md",
    "docs/migration.md",
    "docs/architecture/fbp-runtime.md"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "c8": "12.0.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
